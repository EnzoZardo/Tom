{
  "name": "tom-language",
  "displayName": "Tom Language",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.80.0"
  },
  "contributes": {
    "languages": [
      {
        "id": "tom",
        "aliases": [
          "Tom"
        ],
        "extensions": [
          ".tom"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "tom",
        "scopeName": "source.tom",
        "path": "./syntaxes/tom.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "tomRunner.executar",
        "title": "Executar Tom",
        "icon": "$(play)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "tomRunner.executar",
          "when": "resourceExtname == .tom",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Tom Runner",
      "properties": {
        "tomRunner.jarPath": {
          "type": "string",
          "default": "",
          "description": "Caminho para o tom.jar"
        }
      }
    }
  }
}
