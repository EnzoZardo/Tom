{
  "scopeName": "source.tom",
  "name": "Tom",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#keywords" },
    { "include": "#classes" },
    { "include": "#declarations" },
    { "include": "#functions" },
    { "include": "#dot-access" },
    { "include": "#function-call" },
    { "include": "#types" },
    { "include": "#properties" },
    { "include": "#operators" }
  ],

  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.hashtag.tom",
          "match": "#.*$"
        },
        {
          "name": "comment.block.tom",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },

    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.tom",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.tom",
              "match": "\\\\."
            }
          ]
        }
      ]
    },

    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.tom",
          "match": "\\b\\d+(\\.\\d+)?\\b"
        }
      ]
    },

    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.tom",
          "match": "\\b(se|para|cada|em|enquanto|senao|retorne|continue|pare|herda)\\b"
        },
        {
          "name": "keyword.declaration.tom",
          "match": "\\b(tipo|var|fun|con|classe|novo|inclua)\\b"
        },
        {
          "name": "storage.modifier.access.tom",
          "match": "\\b(publ|prot|priv|est)\\b"
        },
        {
          "name": "variable.language.self.tom",
          "match": "\\b(isso|super)\\b"
        },
        {
          "name": "constant.language.boolean.tom",
          "match": "\\b(verdadeiro|falso)\\b"
        }
      ]
    },

    "classes": {
      "patterns": [
        {
          "name": "meta.class.inheritance.tom",
          "match": "\\b(classe)\\s+([A-Z][a-zA-Z0-9_]*)\\s+(herda)\\s+([A-Z][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.declaration.class.tom" },
            "2": { "name": "entity.name.type.class.tom" },
            "3": { "name": "keyword.control.inheritance.tom" },
            "4": { "name": "entity.other.inherited-class.tom" }
          }
        },
        {
          "name": "meta.class.definition.tom",
          "match": "\\b(classe)\\s+([A-Z][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.declaration.class.tom" },
            "2": { "name": "entity.name.type.class.tom" }
          }
        },
        {
          "name": "meta.class.instantiation.tom",
          "match": "\\b(novo)\\s+([A-Z][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.operator.new.tom" },
            "2": { "name": "entity.name.type.class.tom" }
          }
        }
      ]
    },

    "declarations": {
      "patterns": [
        {
          "name": "meta.import.declaration.tom",
          "match": "\\b(inclua)\\s+([a-zA-Z_][a-zA-Z0-9_./]*)",
          "captures": {
            "1": { "name": "keyword.declaration.tom" },
            "2": { "name": "string.unquoted.import.tom" }
          }
        },
        {
          "name": "meta.variable.declaration.tom",
          "match": "\\b(var|con)\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.declaration.tom" },
            "2": { "name": "variable.other.tom" }
          }
        },
        {
          "name": "meta.type.declaration.tom",
          "match": "\\b(tipo)\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.declaration.tom" },
            "2": { "name": "entity.name.type.tom" }
          }
        }
      ]
    },

    "functions": {
      "patterns": [
        {
          "name": "meta.function.definition.tom",
          "match": "\\b(fun)\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.declaration.tom" },
            "2": { "name": "entity.name.function.tom" }
          }
        },
        {
          "name": "variable.parameter.tom",
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=:\\s*[a-zA-Z_\\[]+)"
        }
      ]
    },

    "dot-access": {
      "patterns": [
        {
          "name": "meta.member.access.call.tom",
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)(\\.)([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()",
          "captures": {
            "1": { "name": "variable.other.object.tom" },
            "2": { "name": "punctuation.accessor.dot.tom" },
            "3": { "name": "entity.name.function.member.tom" }
          }
        },
        {
          "name": "meta.member.access.tom",
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)(\\.)([a-zA-Z_][a-zA-Z0-9_]*)\\b",
          "captures": {
            "1": { "name": "variable.other.object.tom" },
            "2": { "name": "punctuation.accessor.dot.tom" },
            "3": { "name": "variable.other.property.tom" }
          }
        },
        {
          "name": "meta.member.access.self.tom",
          "match": "\\b(isso|super)(\\.)([a-zA-Z_][a-zA-Z0-9_]*)\\b",
          "captures": {
            "1": { "name": "variable.language.self.tom" },
            "2": { "name": "punctuation.accessor.dot.tom" },
            "3": { "name": "variable.other.property.tom" }
          }
        }
      ]
    },

    "function-call": {
      "patterns": [
        {
          "name": "meta.function.call.tom",
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()",
          "captures": {
            "1": { "name": "entity.name.function.call.tom" }
          }
        }
      ]
    },

    "types": {
      "patterns": [
        {
          "name": "storage.type.primitive.tom",
          "match": "\\b(texto|inteiro|nulo|logico|real|caractere)\\b"
        },
        {
          "name": "meta.type.annotation.tom",
          "match": "(:)\\s*(\\[\\])?\\s*([a-zA-Z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "punctuation.separator.type.tom" },
            "2": { "name": "storage.type.array.tom" },
            "3": { "name": "storage.type.tom" }
          }
        },
        {
          "name": "storage.type.custom.tom",
          "match": "\\b[A-Z][a-zA-Z0-9_]*\\b"
        }
      ]
    },

    "properties": {
      "patterns": [
        {
          "name": "variable.other.property.tom",
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=:)",
          "captures": {
            "1": { "name": "variable.other.property.tom" }
          }
        }
      ]
    },

    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.logical.tom",
          "match": "\\b(e|ou|nao)\\b"
        },
        {
          "name": "keyword.operator.word.tom",
          "match": "\\b(congele)\\b"
        },
        {
          "name": "keyword.operator.comparison.tom",
          "match": "==|<>|>=|<=|>|<"
        },
        {
          "name": "keyword.operator.assignment.tom",
          "match": "="
        },
        {
          "name": "keyword.operator.arithmetic.tom",
          "match": "\\+|-|\\*|/"
        },
        {
          "name": "punctuation.separator.colon.tom",
          "match": ":"
        }
      ]
    }
  }
}
