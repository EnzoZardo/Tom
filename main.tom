inclua "./ser.tom"

classe Humano herda Ser 
{
    publ var nome: texto ?

    publ fun Humano(idade: inteiro, nome: texto): Ser
    {
        super(idade)
        isso.nome = nome
    }

    publ fun verifica_entrada(): vazio 
    {
        enquanto (isso.nome <> "José")
        {
            isso.nome = leia("Nome: ")

            se (isso.nome == "José") 
            {
                escreva("Você está proibido de se apresentar")
                retorne ?
            }

            escreva("Olá!", isso.nome, "pode entrar")
        }
    }
}

fun main(): vazio 
{
    con input: texto = leia("Informe sua idade: ")
    con idade: inteiro = inteiro.converte(input)
    
    con nome: texto = leia("Agora, informe seu nome: ")
    
    con pessoa: Humano = novo Humano(idade, nome)

    pessoa.verifica_entrada()

    retorne vazio
}

main()