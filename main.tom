tipo ou_e = { a: inteiro } ou { b: inteiro } e { c: inteiro }

var b: ou_e = { a: 1, c: 2 }
var c: ou_e = { b: 2, c: 3 }

escreva("A primeira é", b)
escreva("A segunda é", c)

