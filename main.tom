tipo vazio = nulo
con vazio: vazio = nulo

classe Animal
{
    publ est var nome: texto = "Rex"
    priv var idade: inteiro = 1
    priv est con mensagem: texto = "Mudamos a idade para:"

    publ fun mudaIdade(): inteiro {
        isso.idade = 3
        escreva(Animal.mensagem, isso.idade)
        retorne isso.idade
    }
}

con estimacao: Animal = novo Animal()
Animal.nome = "Thomas"
estimacao.mudaIdade()
escreva(Animal.mensagem)