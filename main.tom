classe Classe<T, J> 
{
    privado var valor: T ?
    privado var substituto: J ?

    publico fun Classe(s: J): Classe {
        isso.substituto = s
    }

    publico fun pegaValor(): T ou J 
    {
        se (isso.valor == nulo) retorne isso.substituto
        senao retorne isso.valor
    }

    publico fun definaValor(v: T): vazio 
    {
        isso.valor = v
    }
}

const b: Classe<texto, inteiro> = novo Classe<texto, inteiro>(1)

escreva(b.pegaValor())

b.definaValor("Agora foi definido")
escreva(b.pegaValor())