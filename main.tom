# types
tipo int = inteiro
tipo nil = nulo

# constants
con nil: nil = nulo

# classes
classe Age
{
    priv var age: int = 2

    publ fun Age(startAge: int): Age 
    {
        isso.age = startAge
    }

    publ fun getAge() : int 
    { 
        retorne isso.age 
    }

    publ fun setAge() : int 
    { 
        isso.age = inteiro.dez
        retorne isso.age 
    }

    publ fun writeToAge() : nil 
    {
        para cada (age em intervalo(isso.age)) escreva(age)
        retorne nil
    }
}

# instantiation
var age: Age = novo Age(50)

# asserts
escreva("must be 1:", age.getAge())
escreva("must be 2:", Age.getAge())
age.writeToAge()